# ─── Internal working files, not submission artifacts ────────────────────────
# The hackathon asks for a specific artifact set (README.md, STDLIB.md, LICENSE,
# the manifest, .zero-dep.toml, the implementation). Planning notes, research,
# and agent instructions are kept locally but not published.
CLAUDE.md
PLAN.md
docs/

# ─── Generated by LeakLens itself ────────────────────────────────────────────
# Scan artifacts, not source. The patch in particular contains credentials in
# CLEARTEXT by design — it must never reach a repository.
leaklens-fix.patch
*.patch
leaklens-remediation.md
leaklens.env.example
report.json
*.sarif

# ─── Secrets, defensively ────────────────────────────────────────────────────
# A secret scanner whose own repo leaks a credential is the worst possible look.
.env
.env.*
!.env.example
*.pem
*.key
id_rsa
id_ed25519
credentials.json

# ─── Third-party material — must not be vendored ─────────────────────────────
tools/

# ─── Build output ────────────────────────────────────────────────────────────
# Rebuilt by `node leaklens.mjs --build`; the hash is published in README.md.
dist/

# ─── Scratch / local ─────────────────────────────────────────────────────────
.golden/
.new-*.js
.splice.mjs
*.tmp
*.bak
*.original.md

# ─── Node / tooling ──────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
coverage/
.nyc_output/

# ─── Editor / OS ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.swp
.vscode/
